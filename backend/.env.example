NODE_ENV=development
# Use 0.0.0.0 on Render or another container host. This value is optional.
HOST=127.0.0.1
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_POOL_MAX=10
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Comma-separated origins are supported. Do not use * when credentials are enabled.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
GROQ_API_KEY=replace-with-your-groq-api-key

# Production note: for a frontend on a different site, use its exact HTTPS
# origin in CORS_ORIGIN, set COOKIE_SECURE=true, and COOKIE_SAME_SITE=none.
